# =====================================================================
# VIBGYOR Class Updates - Configuration
# =====================================================================

# VIBGYOR Hubble Orion Portal Settings
# Your portal username and password are NOT configured here. You type them into
# the app when you sign in; they are used for that request and never stored.
ORION_BASE_URL=https://hubbleorion.hubblehox.com

# Directory to automatically scan for downloaded VIBGYOR timetable PDFs
# Defaults to project sample_data/ if left blank (e.g. ~/vibgyor)
ORION_DOWNLOADS_DIR=~/vibgyor

# Shared class board (GitHub Pages)
# The passcode class parents type to open the published board. The class content is
# encrypted with it before publishing, so the published file is ciphertext without
# it. Keep it out of the repository; share it with parents directly.
SITE_PASSCODE=
# Republish the board to GitHub Pages after each successful sync
AUTO_PUBLISH=0

# Application Server Settings
PORT=8000
HOST=0.0.0.0
